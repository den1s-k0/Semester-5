        </OBJECT>
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="db09e939-8b80-47d5-aca1-250bfed75b47"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Если вариант использования выполнен успешно, система предоставляет доступ к
главному меню пользователю, сообщившему верную комбинацию имени и пароля. В
противном случае система гарантирует, что пользователю, сообщившему неверную
комбинацию имени и пароля, доступ к меню не будет предоставлен.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
