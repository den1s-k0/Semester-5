      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="f481a115-1c74-451a-9802-1c6c70933dfe"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Общая диаграмма классов архитектуры ИС «Такси». Отражает состав всех классов системы (сущности, граничные, управляющие, интерфейсы) и типы отношений между ними (ассоциации, композиции, зависимости, наследование) без детализации внутренних атрибутов и методов. Предназначена для оценки общей структуры и связности модулей.
]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
      </COMP>
    </DEPENDENCIES>
  </OBJECT>
</EXT>