      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="50efc78b-27a4-4caa-83d7-245e4af7e9ce"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Класс-сущность. Представляет заказчика услуг такси. Хранит ФИО. Операция оформитьЗаказ() создаёт объект класса Заказ и передаёт управление МенеджеруЗаказов. Связан с Заказом ассоциацией 1:0..*  (один клиент делает много заказов).]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
          </DEPENDENCIES>
