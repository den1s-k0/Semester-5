      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="f4bad506-98d1-4712-8289-b8c619ebbcf4"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Класс-сущность. Описывает исполнителя услуги. Атрибут типЗанятости отражает работу в автопарке или на личном авто. Связан с Автомобилем агрегацией (машина может быть заменена), с Заказом ассоциацией 0..1:0..* (водитель назначается на заказ).]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
