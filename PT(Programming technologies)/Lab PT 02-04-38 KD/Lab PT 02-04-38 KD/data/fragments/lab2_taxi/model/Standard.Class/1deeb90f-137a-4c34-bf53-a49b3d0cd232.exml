      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="26fc7c48-b866-48ff-8385-4c071f7dc503"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[ласс-сущность, центральный объект системы. Атрибут номер уникален. Атрибут предварительный различает предзаказ и «на месте». Связан композицией с ДопОпциями и Поездкой — они не могут существовать без заказа.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
