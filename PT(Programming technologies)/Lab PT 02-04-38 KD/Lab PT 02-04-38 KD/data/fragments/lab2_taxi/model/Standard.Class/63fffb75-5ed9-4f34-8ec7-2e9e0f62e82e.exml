      <COMP relation="Descriptor">
        <OBJECT>
          <ID name="" mc="Infrastructure.Note" uid="44779e2f-29be-4385-9f43-26e8722df4bf"/>
          <ATTRIBUTES>
            <ATT name="Content"><![CDATA[Абстрактный класс-сущность, базовый для всех участников системы. Содержит общие атрибуты идентификации и авторизации (логин, пароль, телефон). От него наследуются Клиент, Водитель и Администратор (обобщение). Связан отношением ассоциации 1:0..* с классом Жалоба (каждый пользователь может подать неограниченное число жалоб). Является абстрактным, поскольку не существует «пользователя вообще», только конкретные роли.]]></ATT>
            <ATT name="MimeType"><![CDATA[text/plain]]></ATT>
            <ATT name="Name"></ATT>
            <ATT name="status">1970354901745664</ATT>
          </ATTRIBUTES>
          <DEPENDENCIES>
            <LINK relation="Model">
              <FOREIGNID name="description" mc="Infrastructure.NoteType" uid="00000000-0000-3e81-0000-000000000000"/>
            </LINK>
          </DEPENDENCIES>
        </OBJECT>
      </COMP>
