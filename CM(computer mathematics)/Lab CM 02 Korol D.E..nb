Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"Eliminate", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}], "-", 
         RowBox[{"z", "^", "2"}]}], "==", "1"}], ",", 
       RowBox[{
        RowBox[{"x", "+", "y"}], "==", "z"}], ",", 
       RowBox[{
        RowBox[{"Sinh", "[", "z", "]"}], "==", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"FindRoot", "[", 
    RowBox[{"a", ",", 
     RowBox[{"{", 
      RowBox[{"z", ",", "3"}], "}"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"FindRoot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
