Cell[BoxData[
 RowBox[{"ContourPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"Sin", "[", 
        RowBox[{"x", " ", "+", " ", 
         RowBox[{"I", "*", "y"}]}], "]"}], "]"}], " ", "==", " ", 
      RowBox[{"Re", "[", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", " ", "+", " ", 
           RowBox[{"I", "*", "y"}]}], ")"}], "/", "2"}]}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Im", "[", 
       RowBox[{"Sin", "[", 
        RowBox[{"x", " ", "+", " ", 
         RowBox[{"I", "*", "y"}]}], "]"}], "]"}], " ", "==", " ", 
      RowBox[{"Im", "[", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", " ", "+", " ", 
           RowBox[{"I", "*", "y"}]}], ")"}], "/", "2"}]}], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"y", ",", " ", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]], "Input",
