  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"Exp", "[", 
        RowBox[{"x", "+", 
         RowBox[{"I", "*", "y"}]}], "]"}], "]"}], "==", 
      RowBox[{"Re", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "+", 
          RowBox[{"I", "*", "y"}]}], ")"}], "+", "1"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"Im", "[", 
